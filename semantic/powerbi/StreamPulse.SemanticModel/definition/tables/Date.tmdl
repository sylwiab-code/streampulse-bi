/// Reporting calendar, one row per day (dim_date). Marked as the date table for time intelligence.
table Date
	dataCategory: Time

	/// Calendar day.
	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: DATE_DAY

	/// Calendar year.
	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: CALENDAR_YEAR

	/// Quarter of the year (Q1-Q4).
	column Quarter
		dataType: string
		summarizeBy: none
		sourceColumn: QUARTER_NAME

	/// First day of the month, shown as month and year.
	column Month
		dataType: dateTime
		formatString: mmm yyyy
		summarizeBy: none
		sourceColumn: CALENDAR_MONTH

	/// Short month name (Jan-Dec).
	column 'Month Name'
		dataType: string
		summarizeBy: none
		sourceColumn: MONTH_NAME
		sortByColumn: 'Month Number'

	/// Month number (1-12).
	column 'Month Number'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: MONTH_NUMBER

	/// ISO week number.
	column 'ISO Week'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: ISO_WEEK_NUMBER

	/// Short day name (Mon-Sun).
	column 'Day of Week'
		dataType: string
		summarizeBy: none
		sourceColumn: DAY_NAME
		sortByColumn: 'Day of Week Number'

	/// ISO day of week (1 = Monday).
	column 'Day of Week Number'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: ISO_DAY_OF_WEEK

	/// Saturday or Sunday.
	column 'Is Weekend'
		dataType: boolean
		summarizeBy: none
		sourceColumn: IS_WEEKEND

	partition Date = m
		mode: import
		source =
				let
				    Source = StreamPulse{[Name = "MARTS", Kind = "Schema"]}[Data]{[Name = "DIM_DATE", Kind = "Table"]}[Data],
				    Selected = Table.SelectColumns(Source, {"DATE_DAY", "CALENDAR_YEAR", "QUARTER_NAME", "CALENDAR_MONTH", "MONTH_NUMBER", "MONTH_NAME", "ISO_WEEK_NUMBER", "ISO_DAY_OF_WEEK", "DAY_NAME", "IS_WEEKEND"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"DATE_DAY", type date}, {"CALENDAR_YEAR", Int64.Type}, {"QUARTER_NAME", type text}, {"CALENDAR_MONTH", type date}, {"MONTH_NUMBER", Int64.Type}, {"MONTH_NAME", type text}, {"ISO_WEEK_NUMBER", Int64.Type}, {"ISO_DAY_OF_WEEK", Int64.Type}, {"DAY_NAME", type text}, {"IS_WEEKEND", type logical}})
				in
				    Typed

