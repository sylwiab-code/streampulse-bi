/// Paid-channel spend and new paying customers per month, market, and channel (kpi_cac_ltv_monthly). Organic and referral channels are not included.
table 'Acquisition Cost'

	/// Paid-channel campaign spend in EUR.
	measure 'Marketing Spend (EUR)' = SUM ( 'Acquisition Cost'[spend_eur] )
		formatString: \€#,0
		displayFolder: Acquisition

	/// Customers acquired through a paid channel with their first payment in the period.
	measure 'New Paying Customers' = SUM ( 'Acquisition Cost'[new_paying_customers] )
		formatString: #,0
		displayFolder: Acquisition

	/// Customer acquisition cost in EUR: paid-channel spend / new paying customers from those channels.
	measure 'CAC (EUR)' = DIVIDE ( SUM ( 'Acquisition Cost'[spend_eur] ), SUM ( 'Acquisition Cost'[new_paying_customers] ) )
		formatString: \€#,0.00
		displayFolder: Acquisition

	/// Customer lifetime value in EUR: market ARPU / monthly churn rate (revenue-based, no margin data). Not affected by the channel filter.
	measure 'LTV (EUR)' = DIVIDE ( [ARPU (EUR)], [Monthly Churn Rate] )
		formatString: \€#,0.00
		displayFolder: Acquisition

	/// LTV / CAC.
	measure 'LTV to CAC' = DIVIDE ( [LTV (EUR)], [CAC (EUR)] )
		formatString: 0.00
		displayFolder: Acquisition

	/// Month (first day).
	column calendar_month
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: CALENDAR_MONTH

	/// Market key.
	column market_code
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: MARKET_CODE

	/// Paid acquisition channel key.
	column acquisition_channel
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: ACQUISITION_CHANNEL

	/// Spend in EUR.
	column spend_eur
		dataType: decimal
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: SPEND_EUR

	/// Customers from this channel with their first payment in the month.
	column new_paying_customers
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: NEW_PAYING_CUSTOMERS

	partition 'Acquisition Cost' = m
		mode: import
		source =
				let
				    Source = StreamPulse{[Name = "KPI", Kind = "Schema"]}[Data]{[Name = "KPI_CAC_LTV_MONTHLY", Kind = "Table"]}[Data],
				    Selected = Table.SelectColumns(Source, {"CALENDAR_MONTH", "MARKET_CODE", "ACQUISITION_CHANNEL", "SPEND_EUR", "NEW_PAYING_CUSTOMERS"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"CALENDAR_MONTH", type date}, {"MARKET_CODE", type text}, {"ACQUISITION_CHANNEL", type text}, {"SPEND_EUR", Currency.Type}, {"NEW_PAYING_CUSTOMERS", Int64.Type}})
				in
				    Typed

