/// StreamPulse semantic model: subscribers, revenue, churn, trials, retention, acquisition, and viewing for the OTT service. Import from the Snowflake KPI and MARTS schemas (ADR-011).
model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US

annotation __PBI_TimeIntelligenceEnabled = 1

annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["DATECOLUMN_FORMATSTRING","MONTHCOLUMN_FORMATSTRING","INTEGER_FORMATTING","RELATIONSHIP_COLUMNS_SHOULD_BE_OF_INTEGER_DATA_TYPE","REMOVE_ROLES_WITH_NO_MEMBERS"]}

ref table Date
ref table Market
ref table Plan
ref table Channel
ref table Campaign
ref table Content
ref table Customer
ref table 'Subscribers Daily'
ref table 'MRR Movements'
ref table Churn
ref table 'Trial Conversion'
ref table 'Cohort Retention'
ref table 'Acquisition Cost'
ref table Payments
ref table 'Viewing Sessions'
ref table 'DE MRR Net of VAT'
ref table 'Security Market Access'
ref table 'Time Intelligence'
ref table 'KPI Selector'
ref table 'Dimension Selector'

ref role Global
ref role Market
ref role 'Content Analyst'

ref perspective Executive
ref perspective Content

ref cultureInfo en-US
ref cultureInfo pl-PL

