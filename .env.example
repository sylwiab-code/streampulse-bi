# Copy to .env and fill in. .env is gitignored and must never be committed.
# Local development uses DEV only. Never put TEST or PROD credentials here:
# those exist only in GitHub Environments and are used by the CD workflow.
# Variables are added by the phase that first needs them; the Snowflake
# block below is provisional until Phase 2 (ADR-003).

# Snowflake, DEV (used from Phase 2 by the loader, Liquibase, and dbt)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
# Path to the private key file for key-pair authentication (*.p8 files are gitignored)
SNOWFLAKE_PRIVATE_KEY_PATH=
