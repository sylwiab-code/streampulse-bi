# Copy to .env and fill in. .env is gitignored and must never be committed.
# Local development uses DEV only. Never put TEST or PROD credentials here:
# those exist only in GitHub Environments and are used by the CD workflow.
# Setup steps: docs/guides/snowflake-setup.md

# Snowflake, DEV: used by Liquibase (database/liquibase/run.py), the loader, and the
# integration tests. Roles and warehouses are derived from the environment name.
# Account identifier in the format orgname-accountname
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=SVC_DEPLOYER_DEV
# Private key for key-pair authentication; keep it outside the repository.
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/keys/svc_deployer_dev.p8

# Set to 1 to run the integration tests against Snowflake DEV.
STREAMPULSE_SNOWFLAKE_TESTS=

# Airflow alerts (ADR-010): Slack incoming webhook URL. Without it, alerts are only logged.
SLACK_WEBHOOK_URL=

# Power BI (Phase 5, ADR-008): service principal and target semantic model. The Airflow
# refresh tasks run only when POWERBI_ENABLED=true.
POWERBI_ENABLED=false
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_DATASET_ID=
